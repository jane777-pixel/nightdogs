{
	"name": "nightdogs",
	"version": "2.0.0",
	"private": true,
	"description": "nightdogs.xyz — a multi-author blog built with Eleventy",
	"type": "module",
	"scripts": {
		"build": "cross-env ELEVENTY_ENV=production eleventy",
		"build-dev": "eleventy",
		"build-fast": "cross-env ELEVENTY_ENV=development eleventy",
		"optimize-images": "node scripts/optimize-images.js",
		"build-nocolor": "cross-env NODE_DISABLE_COLORS=1 eleventy",
		"start": "eleventy --serve",
		"debug": "cross-env DEBUG=Eleventy* eleventy",
		"debugstart": "cross-env DEBUG=Eleventy* eleventy --serve --quiet",
		"benchmark": "cross-env DEBUG=Eleventy:Benchmark* eleventy",
		"test": "node test/run-tests.js",
		"test:build": "node test/build.test.js",
		"test:content": "node test/content-validation.test.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jane777-pixel/nightdogs.git"
	},
	"author": {
		"name": "Jane Marie Bach",
		"url": "https://nightdogs.xyz/"
	},
	"license": "MIT",
	"homepage": "https://nightdogs.xyz/",
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@11ty/eleventy": "^3.1.7",
		"@11ty/eleventy-fetch": "^6.0.1",
		"@11ty/eleventy-img": "^7.1.1",
		"@11ty/eleventy-navigation": "^1.0.5",
		"@11ty/eleventy-plugin-rss": "^3.1.0",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
		"@zachleat/heading-anchors": "^1.0.5",
		"gray-matter": "^4.0.3",
		"luxon": "^3.7.2"
	},
	"devDependencies": {
		"cross-env": "^10.1.0",
		"glob": "^14.0.3",
		"netlify-plugin-cache": "^1.0.3",
		"prismjs": "^1.30.0",
		"sharp": "^0.35.5",
		"zod": "^3.25.67",
		"zod-validation-error": "^3.5.2"
	}
}

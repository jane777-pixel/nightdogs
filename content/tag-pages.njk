---js
// <script>
const pagination = {
	data: "collections",
	size: 1,
	alias: "tag",
	filter: ["all", "posts"],
	// addAllPagesToCollections: true,
};

const eleventyExcludeFromCollections = true;

const eleventyComputed = {
	title: "Tagged '{{ tag }}'",
	permalink: function(data) {
		return `/tags/${this.slugify(data.tag)}/`;
	}
};
---
<h1>Tagged “{{ tag }}”</h1>
{%- set tagInfo = tagDescriptions.tags[tag] %}
{%- if tagInfo %}
<p class="intro">{{ tagInfo.icon }} {{ tagInfo.description }}</p>
{%- endif %}

{% set postslist = collections[ tag ] %}
{% include "postslist.njk" %}

<p>See <a href="/explore/">all posts and tags</a>.</p>

---js
const eleventyNavigation = {
	key: "Explore",
	order: 2
};
const title = "Explore";
const description = "Every post on nightdogs, by author and tag.";
---
{%- set allPosts = collections.posts | reverse %}
{%- set tagStats = allPosts | getTagStats %}

<style>
.explore-filters {
	display: grid;
	gap: 1rem;
	margin: 0 0 2rem;
	padding: 1rem;
	border: 1px solid var(--border);
	border-radius: var(--radius);
	background: var(--surface);
}
.explore-filters fieldset {
	border: 0;
	margin: 0;
	padding: 0;
}
.explore-filters legend,
.explore-filters .filter-label {
	display: block;
	font-size: var(--step--1);
	font-weight: 600;
	margin-bottom: 0.4rem;
}
.filter-row {
	display: flex;
	flex-wrap: wrap;
	gap: 0.4rem;
}
.chip {
	display: inline-flex;
	align-items: center;
	gap: 0.35em;
	min-height: 2.25rem;
	padding: 0.2rem 0.8rem;
	border: 1px solid var(--border);
	border-radius: 999px;
	background: var(--background-color);
	color: var(--color);
	font-size: var(--step--1);
	cursor: pointer;
}
.chip:hover {
	border-color: var(--primary);
}
.chip[aria-pressed="true"] {
	background: var(--primary);
	border-color: var(--primary);
	color: var(--background-color);
}
.chip .swatch {
	width: 0.75rem;
	height: 0.75rem;
	border-radius: 50%;
	border: 1px solid var(--border);
}
.filter-controls {
	display: flex;
	flex-wrap: wrap;
	gap: 0.75rem 1rem;
	align-items: end;
}
.filter-controls label {
	display: grid;
	gap: 0.25rem;
	flex: 1 1 12rem;
}
.filter-controls input,
.filter-controls select {
	min-height: 2.5rem;
	padding: 0.4rem 0.7rem;
	border: 1px solid var(--border);
	border-radius: 8px;
	background: var(--background-color);
	color: var(--color);
}
.explore-count {
	font-size: var(--step--1);
	color: var(--muted-color);
	margin: 0 0 1rem;
}
.card-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr));
	gap: 1.25rem;
	list-style: none;
	padding: 0;
	margin: 0 0 2rem;
}
.card {
	position: relative;
	display: flex;
	flex-direction: column;
	border: 1px solid var(--border);
	border-radius: var(--radius);
	background: var(--surface);
	overflow: hidden;
	transition: border-color var(--transition), transform var(--transition);
}
.card:hover {
	border-color: var(--primary);
	transform: translateY(-2px);
}
.card:focus-within {
	border-color: var(--primary);
}
.card__image {
	aspect-ratio: 3 / 2;
	background: var(--surface-strong);
}
.card__image img,
.card__image picture {
	width: 100%;
	height: 100%;
	object-fit: cover;
	display: block;
}
.card__image--empty {
	display: grid;
	place-items: center;
	font-family: var(--font-heading);
	font-size: 2.5rem;
	color: var(--muted-color);
}
.card__body {
	padding: 0.9rem 1rem 1rem;
	display: grid;
	gap: 0.35rem;
}
.card__title {
	font-size: var(--step-1);
	margin: 0;
}
.card__title a {
	color: var(--color);
	text-decoration: none;
}
.card__title a::after {
	/* make the whole card clickable */
	content: "";
	position: absolute;
	inset: 0;
}
.card__title a:focus-visible {
	outline: none;
}
.card:has(.card__title a:focus-visible) {
	outline: 3px solid var(--focus);
	outline-offset: 2px;
}
.card__meta {
	font-size: var(--step--1);
	color: var(--muted-color);
	margin: 0;
}
.card__excerpt {
	font-size: var(--step--1);
	line-height: 1.5;
	margin: 0;
}
.card[hidden] {
	display: none;
}
.explore-tags {
	display: flex;
	flex-wrap: wrap;
	gap: 0.4rem;
	list-style: none;
	padding: 0;
}
</style>

<h1>Explore</h1>
<p class="intro">All {{ allPosts.length }} posts, newest first. Narrow them down by author or tag.</p>

<form class="explore-filters" id="explore-filters" role="search" aria-label="Filter posts" onsubmit="return false">
	<fieldset>
		<legend>Author</legend>
		<div class="filter-row" data-filter="author">
			<button type="button" class="chip" data-value="" aria-pressed="true">Everyone</button>
			{%- for key, person in authors %}
			{%- set count = (allPosts | filterByAuthor(key)).length %}
			{%- if count %}
			<button type="button" class="chip" data-value="{{ key }}" aria-pressed="false">
				<span class="swatch" style="background: var(--author-{{ key }}-primary)" aria-hidden="true"></span>
				{{ person.name | firstName }} <span aria-hidden="true">({{ count }})</span><span class="visually-hidden">, {{ count }} posts</span>
			</button>
			{%- endif %}
			{%- endfor %}
		</div>
	</fieldset>

	<div class="filter-controls">
		<label>
			<span class="filter-label">Tag</span>
			<select id="filter-tag">
				<option value="">All tags</option>
				{%- for tagInfo in tagStats %}
				{%- set info = tagDescriptions.tags[tagInfo.tag] %}
				<option value="{{ tagInfo.tag }}">{% if info %}{{ info.icon }} {% endif %}{{ tagInfo.tag }} ({{ tagInfo.count }})</option>
				{%- endfor %}
			</select>
		</label>
		<label>
			<span class="filter-label">Sort</span>
			<select id="filter-sort">
				<option value="new">Newest first</option>
				<option value="old">Oldest first</option>
				<option value="title">Title A–Z</option>
				<option value="photos">Most photos</option>
			</select>
		</label>
		<label>
			<span class="filter-label">Contains</span>
			<input type="search" id="filter-text" placeholder="Words in the title or text" autocomplete="off">
		</label>
	</div>
</form>

<p class="explore-count" id="explore-count" role="status" aria-live="polite">Showing all {{ allPosts.length }} posts</p>

<ul class="card-grid" id="explore-grid">
	{%- for post in allPosts %}
	{%- set person = authors[post.data.author] %}
	{%- set thumb = post.inputPath | firstImage(post.data.featuredImage) %}
	{%- set postDate = post.date | parseCMSDate %}
	{%- set summary = post.data.description or (post.templateContent | excerptText(120)) %}
	{%- set photoCount = (post.templateContent | split("<img")).length - 1 %}
	<li class="card"
		data-author="{{ post.data.author }}"
		data-tags="{{ post.data.tags | filterTagList | join('|') }}"
		data-date="{{ post.date | htmlDateString }}"
		data-title="{{ post.data.title | lower }}"
		data-photos="{{ photoCount }}"
		data-text="{{ (post.data.title ~ ' ' ~ (post.templateContent | excerptText(3000))) | lower }}">
		{%- if thumb %}
		<div class="card__image">
			<img src="{{ thumb.src }}" alt="" sizes="(max-width: 600px) 100vw, 320px" loading="lazy" decoding="async">
		</div>
		{%- else %}
		<div class="card__image card__image--empty" aria-hidden="true">{{ post.data.title | first }}</div>
		{%- endif %}
		<div class="card__body">
			<h2 class="card__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
			<p class="card__meta">
				{%- if person %}{{ person.name | firstName }}{% endif %}
				{%- if postDate %} · <time datetime="{{ post.date | htmlDateString }}">{{ postDate | readableDate("d LLL yyyy") }}</time>{% endif %}
				{%- if photoCount > 1 %} · {{ photoCount }} photos{% endif %}
			</p>
			{%- if summary | trim %}
			<p class="card__excerpt">{{ summary }}</p>
			{%- endif %}
		</div>
	</li>
	{%- endfor %}
</ul>

<h2>All tags</h2>
<ul class="explore-tags">
	{%- for tagInfo in tagStats %}
	{%- set info = tagDescriptions.tags[tagInfo.tag] %}
	<li><a class="tag-chip" href="/tags/{{ tagInfo.tag | slugify }}/"{% if info %} title="{{ info.description }}"{% endif %}>{% if info %}{{ info.icon }} {% endif %}{{ tagInfo.tag }} <span aria-hidden="true">({{ tagInfo.count }})</span></a></li>
	{%- endfor %}
</ul>

<script>
(function () {
	const grid = document.getElementById("explore-grid");
	const cards = Array.from(grid.children);
	const count = document.getElementById("explore-count");
	const authorChips = document.querySelectorAll('[data-filter="author"] .chip');
	const tagSelect = document.getElementById("filter-tag");
	const sortSelect = document.getElementById("filter-sort");
	const textInput = document.getElementById("filter-text");
	const state = { author: "", tag: "", sort: "new", text: "" };

	// Let links like /explore/?tag=music or ?author=jane pre-select filters
	const params = new URLSearchParams(location.search);
	state.author = params.get("author") || "";
	state.tag = params.get("tag") || "";
	tagSelect.value = state.tag;

	const sorters = {
		new: (a, b) => b.dataset.date.localeCompare(a.dataset.date),
		old: (a, b) => a.dataset.date.localeCompare(b.dataset.date),
		title: (a, b) => a.dataset.title.localeCompare(b.dataset.title),
		photos: (a, b) => b.dataset.photos - a.dataset.photos || sorters.new(a, b),
	};

	function update() {
		const words = state.text.toLowerCase().split(/\s+/).filter(Boolean);
		let shown = 0;
		cards.sort(sorters[state.sort]).forEach((card) => {
			const visible =
				(!state.author || card.dataset.author === state.author) &&
				(!state.tag || card.dataset.tags.split("|").includes(state.tag)) &&
				words.every((word) => card.dataset.text.includes(word));
			card.hidden = !visible;
			if (visible) shown++;
			grid.append(card); // re-append in sorted order
		});
		authorChips.forEach((chip) =>
			chip.setAttribute("aria-pressed", String(chip.dataset.value === state.author)),
		);
		count.textContent =
			shown === cards.length ? `Showing all ${shown} posts` : `Showing ${shown} of ${cards.length} posts`;
	}

	authorChips.forEach((chip) =>
		chip.addEventListener("click", () => {
			state.author = chip.dataset.value;
			update();
		}),
	);
	tagSelect.addEventListener("change", () => {
		state.tag = tagSelect.value;
		update();
	});
	sortSelect.addEventListener("change", () => {
		state.sort = sortSelect.value;
		update();
	});
	textInput.addEventListener("input", () => {
		state.text = textInput.value;
		update();
	});

	if (state.author || state.tag) update();
})();
</script>

---js
const eleventyNavigation = {
	key: "Home",
	order: 1
};

const numberOfLatestPostsToShow = 8;
---
<h1 class="visually-hidden">nightdogs</h1>
<h2>Latest posts</h2>
{% set postslist = collections.posts | head(-1 * numberOfLatestPostsToShow) %}
{% include "postslist.njk" %}

{% set morePosts = (collections.posts | length) - numberOfLatestPostsToShow %}
{% if morePosts > 0 %}
<p><a class="more-link" href="/explore/">See all {{ collections.posts | length }} posts →</a></p>
{% endif %}

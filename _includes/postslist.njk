{#- A list of posts with date, author, a short excerpt and a thumbnail.
    Set `postslist` before including. #}
<ol class="postlist" reversed>
	{%- for post in postslist | reverse %}
	{%- set person = authors[post.data.author] %}
	{%- set thumb = post.inputPath | firstImage(post.data.featuredImage) %}
	{%- set postDate = post.date | parseCMSDate %}
	<li class="postlist-item" data-author="{{ post.data.author }}">
		<div>
			<a href="{{ post.url }}" class="postlist-link">{{ post.data.title or post.url }}</a>
			<p class="postlist-meta">
				{%- if postDate %}<time datetime="{{ post.date | htmlDateString }}">{{ postDate | readableDate("d LLLL yyyy") }}</time>{% endif %}
				{%- if person %} · {{ person.name }}{% endif %}
			</p>
			{%- set summary = post.data.description or (post.templateContent | excerptText(140)) %}
			{%- if summary | trim %}
			<p class="postlist-excerpt">{{ summary }}</p>
			{%- endif %}
		</div>
		{%- if thumb %}
		<a href="{{ post.url }}" class="postlist-thumb" tabindex="-1" aria-hidden="true">
			<img src="{{ thumb.src }}" alt="" sizes="112px" loading="lazy" decoding="async">
		</a>
		{%- endif %}
	</li>
	{%- endfor %}
</ol>

---
layout: layouts/base.njk
---
{#- Syntax highlighting, only needed on posts #}
<style>
	{% include "node_modules/prismjs/themes/prism-okaidia.css" %}
</style>
<style>
	{% include "css/prism-diff.css" %}
</style>

{%- set person = authors[author] %}
<article class="post h-entry{% if photoLayout == 'grid' %} post--grid{% endif %}">
	<header class="post-header">
		<h1 class="post-title p-name">{{ title }}</h1>
		<p class="post-meta">
			{%- set parsedDate = page.date | parseCMSDate %}
			<time class="dt-published" datetime="{{ page.date | htmlDateString }}">{% if parsedDate %}{{ parsedDate | readableDate }}{% endif %}</time>
			{%- if person %}
			<span class="post-author">by <a href="/authors/{{ author }}/" class="h-card p-author">{{ person.name }}</a>
				{%- if collaborators and collaborators.length %} with
				{%- for collaborator in collaborators %} <a href="/authors/{{ collaborator }}/" class="h-card">{{ authors[collaborator].name or collaborator }}</a>{% if not loop.last %},{% endif %}{% endfor %}
				{%- endif %}
			</span>
			{%- endif %}
			{%- set minutes = ((content | wordCount) / 200) | round(0, "ceil") %}
			<span>{{ minutes if minutes > 1 else 1 }} min read</span>
		</p>
		{%- set postTags = tags | unique | filterTagList %}
		{%- if postTags.length %}
		<ul class="post-tags" aria-label="Tags">
			{%- for tag in postTags %}
			<li><a href="/tags/{{ tag | slugify }}/" class="post-tag p-category">{{ tag }}</a></li>
			{%- endfor %}
		</ul>
		{%- endif %}
	</header>

	<div class="e-content">
		{{ content | safe }}
	</div>

	<footer class="post-footer">
		{%- set newerPost = collections.posts | getNextCollectionItem(page) %}
		{%- set olderPost = collections.posts | getPreviousCollectionItem(page) %}
		{%- if newerPost or olderPost %}
		<nav aria-label="More posts">
			<ul class="post-nav">
				{%- if olderPost %}
				<li class="post-nav__prev"><span>← Older</span><a href="{{ olderPost.url }}">{{ olderPost.data.title }}</a></li>
				{%- endif %}
				{%- if newerPost %}
				<li class="post-nav__next"><span>Newer →</span><a href="{{ newerPost.url }}">{{ newerPost.data.title }}</a></li>
				{%- endif %}
			</ul>
		</nav>
		{%- endif %}

		{%- if person %}
		{%- set authorPosts = collections.posts | filterByAuthor(author) | reverse | reject("url", page.url) | head(3) %}
		{%- if authorPosts.length %}
		<h2>More from {{ person.name | firstName }}</h2>
		<ul class="more-posts">
			{%- for post in authorPosts %}
			{%- set postDate = post.date | parseCMSDate %}
			<li><a href="{{ post.url }}">{{ post.data.title }}</a>{% if postDate %}<small>{{ postDate | readableDate("LLL yyyy") }}</small>{% endif %}</li>
			{%- endfor %}
		</ul>
		{%- endif %}
		{%- endif %}

		{% set webmentionsUrl = page.url %}
		{% include "webmentions.njk" %}
	</footer>
</article>

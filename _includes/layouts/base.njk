<!doctype html>
{#- The author whose colours this page uses: the post's author, or the author
    whose profile this is. Other pages use the reader's chosen theme. -#}
{%- set pageAuthor = author if (author and authors[author]) else (authorKey if authorKey else "") -%}
{%- set isPost = layout == "layouts/post.njk" -%}
{%- set pageTitle = (title ~ " · " ~ metadata.title) if (title and page.url != "/") else metadata.title -%}
{%- set pageDescription = description or excerpt or metadata.description -%}
{%- set canonicalUrl = page.url | absoluteUrl(metadata.url) -%}
<html lang="{{ metadata.language }}"{% if pageAuthor %} data-author="{{ pageAuthor }}" data-page-author="{{ pageAuthor }}"{% endif %}>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<script>
			// Apply the saved theme before anything is drawn (no flash of the wrong colours)
			(function () {
				var root = document.documentElement;
				try {
					if (!root.dataset.author) root.dataset.author = localStorage.getItem("author-theme") || "jane";
					var dark = localStorage.getItem("nightdogs-dark-mode");
					if (dark === "true") root.dataset.theme = "dark";
					else if (dark === "false") root.dataset.theme = "light";
				} catch (e) {
					if (!root.dataset.author) root.dataset.author = "jane";
				}
			})();
		</script>
		<title>{{ pageTitle }}</title>
		<meta name="description" content="{{ pageDescription | striptags | truncate(200) }}">
		<link rel="canonical" href="{{ canonicalUrl }}">

		{#- Link previews (Open Graph / social) #}
		<meta property="og:site_name" content="{{ metadata.title }}">
		<meta property="og:title" content="{{ title or metadata.title }}">
		<meta property="og:description" content="{{ pageDescription | striptags | truncate(200) }}">
		<meta property="og:url" content="{{ canonicalUrl }}">
		<meta property="og:locale" content="en_CA">
		{%- if isPost %}
		<meta property="og:type" content="article">
		<meta property="article:published_time" content="{{ page.date | htmlDateString }}">
		{%- if authors[author] %}<meta property="article:author" content="{{ authors[author].name }}">{% endif %}
		{%- else %}
		<meta property="og:type" content="website">
		{%- endif %}
		{%- set socialImage = "" %}
		{%- if isPost %}{% set socialImage = page.inputPath | socialImage(featuredImage or image) %}{% endif %}
		{%- if socialImage %}
		<meta property="og:image" content="{{ socialImage | absoluteUrl(metadata.url) }}">
		<meta name="twitter:card" content="summary_large_image">
		{%- else %}
		<meta property="og:image" content="{{ '/img/icon-512.png' | absoluteUrl(metadata.url) }}">
		<meta name="twitter:card" content="summary">
		{%- endif %}

		{#- Icons, app manifest and browser colours #}
		<link rel="icon" href="/favicon.svg" type="image/svg+xml">
		<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
		<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
		<link rel="manifest" href="/manifest.json">
		{%- set themeAuthor = authors[pageAuthor] or authors.jane %}
		<meta name="theme-color" content="{{ themeAuthor.theme.light.background }}" media="(prefers-color-scheme: light)">
		<meta name="theme-color" content="{{ themeAuthor.theme.dark.background }}" media="(prefers-color-scheme: dark)">

		{#- Feeds #}
		<link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title="{{ metadata.title }} — all posts">
		{%- if pageAuthor %}
		<link rel="alternate" href="/feed/{{ pageAuthor }}.xml" type="application/atom+xml" title="{{ metadata.title }} — posts by {{ authors[pageAuthor].name }}">
		{%- endif %}

		<link rel="stylesheet" href="/css/fonts.css">
		<link rel="stylesheet" href="/css/print.css" media="print">
		{%- if isPost %}
		<link rel="stylesheet" href="/css/webmentions.css">
		{%- endif %}

		<script>
			window.NIGHTDOGS_DOG_PEOPLE = {
				{%- for key, person in authors %}
				{{ key | dump | safe }}: {{ person.isDogPerson | default(false) | dump }}{% if not loop.last %},{% endif %}
				{%- endfor %}
			};
		</script>

		{% css %}
/* ---- Author themes, generated from _data/authors.json ---------------- */
:root {
{%- for key, person in authors | dictsort %}
	--author-{{ key }}-background: {{ person.theme.light.background }};
	--author-{{ key }}-color: {{ person.theme.light.color }};
	--author-{{ key }}-primary: {{ person.theme.light.primary }};
	--author-{{ key }}-muted: {{ person.theme.light.muted }};
	--{{ key }}-primary: var(--author-{{ key }}-primary);
{%- endfor %}
}
{%- for key, person in authors | dictsort %}
:root[data-author="{{ key }}"] {
	--background-color: {{ person.theme.light.background }};
	--color: {{ person.theme.light.color }};
	--primary: {{ person.theme.light.primary }};
	--muted-color: {{ person.theme.light.muted }};
	--font-body: {{ person.theme.fonts.body | default("inherit") | safe }};
	--font-heading: {{ person.theme.fonts.header | default(person.theme.fonts.body) | default("inherit") | safe }};
	{%- if person.theme.fonts.mono %}
	--font-mono: {{ person.theme.fonts.mono | safe }};
	{%- endif %}
	color-scheme: light;
}
{%- endfor %}
{%- macro darkTheme(authors) %}
	{%- for key, person in authors | dictsort %}
	:root[data-author="{{ key }}"]SELECTOR {
		--background-color: {{ person.theme.dark.background }};
		--color: {{ person.theme.dark.color }};
		--primary: {{ person.theme.dark.primary }};
		--muted-color: {{ person.theme.dark.muted }};
		color-scheme: dark;
	}
	{%- endfor %}
	:rootSELECTOR {
	{%- for key, person in authors | dictsort %}
		--author-{{ key }}-background: {{ person.theme.dark.background }};
		--author-{{ key }}-color: {{ person.theme.dark.color }};
		--author-{{ key }}-primary: {{ person.theme.dark.primary }};
		--author-{{ key }}-muted: {{ person.theme.dark.muted }};
	{%- endfor %}
	}
{%- endmacro %}
/* Dark mode: follows the device unless the reader picked light or dark */
@media (prefers-color-scheme: dark) {
{{ darkTheme(authors) | replace("SELECTOR", ':not([data-theme="light"])') | safe }}
}
{{ darkTheme(authors) | replace("SELECTOR", '[data-theme="dark"]') | safe }}

{% include "css/index.css" %}
		{% endcss %}
		<style>{% getBundle "css" %}</style>

		{#- Heading anchor links #}
		<script type="module">{% include "node_modules/@zachleat/heading-anchors/heading-anchors.js" %}</script>

		{#- IndieWeb: sign-in, identity and webmentions #}
		<link rel="authorization_endpoint" href="https://indieauth.com/auth">
		<link rel="token_endpoint" href="https://tokens.indieauth.com/token">
		<link rel="me" href="https://github.com/jane777-pixel">
		<link rel="me" href="mailto:haileebach@gmail.com">
		<link rel="me" href="mailto:orionlw@pm.me">
		<link rel="me" href="https://github.com/orionlw">
		<link rel="webmention" href="https://webmention.io/nightdogs.xyz/webmention">
		<link rel="pingback" href="https://webmention.io/nightdogs.xyz/xmlrpc">
	</head>
	<body class="h-card">
		<a href="#main" class="skip-link">Skip to content</a>

		<header class="site-header">
			<div class="site-header__inner">
				<a href="/" class="site-title p-name u-url" rel="home">nightdogs</a>

				<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
					<span class="menu-toggle__bars" aria-hidden="true"></span>
					<span class="menu-toggle__label">Menu</span>
				</button>

				<div class="site-menu" id="site-menu">
					<nav class="site-nav" aria-label="Main">
						<ul>
						{%- for entry in collections.all | eleventyNavigation %}
							<li><a href="{{ entry.url }}"{% if entry.url == page.url %} aria-current="page"{% endif %}{% if entry.url == "/cat/" %} data-cat-link{% endif %}>{{ entry.title }}</a></li>
						{%- endfor %}
						</ul>
					</nav>

					<div class="site-tools">
						<button type="button" class="tool-button" data-search-trigger>
							<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
							<span>Search</span>
						</button>
						<button type="button" class="tool-button" id="dark-mode-toggle" aria-pressed="false">
							<span data-icon aria-hidden="true">☾</span>
							<span>Dark mode</span>
						</button>
						<label class="theme-picker">
							<span>Colours</span>
							<select id="author-select" class="author-sync" name="author-select">
							{%- for key, person in authors %}
								<option value="{{ key }}">{{ person.name | firstName }}</option>
							{%- endfor %}
							</select>
						</label>
					</div>
				</div>
			</div>
		</header>

		<main id="main" class="site-main" tabindex="-1">
			<heading-anchors>
				{{ content | safe }}
			</heading-anchors>
		</main>

		<footer class="site-footer">
			<nav aria-label="Footer">
				<ul>
					<li><a href="/explore/">All posts</a></li>
					<li><a href="/authors/">Authors</a></li>
					<li><a href="/feeds/">RSS feeds</a></li>
					<li><a href="/admin/">Write</a></li>
				</ul>
			</nav>
			<p class="site-footer__note">nightdogs are hotdogs you eat in the middle of the night.</p>
		</footer>

		<script src="/js/site.js" defer></script>
		<script src="/js/search.js" defer></script>
		{%- if isPost %}
		<script src="/js/lightbox.js" defer></script>
		{%- endif %}
	</body>
</html>
